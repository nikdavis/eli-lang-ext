{
  "manifest_version": 3,
  "name": "eli-lang",
  "version": "0.1.0",
  "description": "ELI5 any website in your target language - language learning through immersion",

  "browser_specific_settings": {
    "gecko": {
      "id": "eli-lang@example.com",
      "strict_min_version": "115.0"
    }
  },

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "eli-lang"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "48": "assets/icon-48.png",
    "96": "assets/icon-96.png"
  }
}
